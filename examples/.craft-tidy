# Example craft-tidy configuration.
#
# Copy this file to the root of your craft project as `.craft-tidy`.
# craft-tidy looks for it in the project directory and its parents. Every key
# is optional; omitted keys keep their defaults. Every value below is the
# default, so the copy changes nothing until you edit it. Command line flags
# take precedence over this file: they override most values, while the
# globs of `checks` and `warnings-as-errors` given on the command line are
# appended to the ones here, a `*` or `-*` glob replacing all globs before
# it (see `craft-tidy --help`), and
# `craft-tidy --dump-config` shows the effective configuration.

# Globs selecting the checks to run, evaluated left to right; the last glob
# matching a check decides whether it runs. `*` matches any characters and a
# leading `-` disables the matching checks. To run only some checks, start
# with "-*" (e.g. "-*,style-*"): a positive glob such as "style-*" on its own
# leaves every check enabled. Check names start with their
# category (`metadata-`, `project-`, `snapcraft-`, `style-`). Run `craft-tidy --list-checks --checks='*'`
# to see them all.
# This can also be a comma-separated string, e.g. "*,-style-sorted-lists" to
# run every check except style-sorted-lists. Default: "*" (all checks).
checks:
  - "*"

# Globs selecting checks whose findings are reported as errors, which makes
# craft-tidy exit with status 1, e.g. "project-*,style-line-length".
# Default: "" (all findings are warnings).
warnings-as-errors: ""

# Whether to fix problems where possible, rewriting the project file in
# place before reporting what remains. Same as passing `--fix`; `--no-fix`
# overrides it. Default: false.
fix: false

# Options for individual checks, keyed by check name. Values may be booleans,
# integers, floats or strings. Run `craft-tidy --explain CHECK` to see the
# options supported by a check; unknown options are rejected.
check-options:
  snapcraft-components:
    # Also report components that are defined but that no part puts files
    # in, which would be packed empty. Default: true.
    report-unused: true
  style-collapsed-sequences:
    # Sequences of strings with at most this many items must be written on
    # one line (`plugs: [home]`), longer ones one item per line.
    # Short sequences whose one-line form would exceed style-line-length's
    # max-length stay one item per line. Default: 1.
    max-collapsed-items: 1
  style-line-length:
    # Maximum number of characters per line. Default: 80.
    max-length: 80
  style-sorted-lists:
    # Globs selecting the keys whose lists must be sorted, in the same syntax
    # as `checks`. Only include keys whose order does not matter to the craft tools
    # (not, for example, command-chain or build tool arguments). Spaces after
    # commas are ignored, so the value can continue on the next line. The
    # default is shown here.
    keys: after,assumes,before,build-attributes,build-for,build-on,
      build-packages,build-snaps,plugs,slots,stage-packages,stage-snaps
    # Sort uppercase letters before lowercase ones. Default: false.
    case-sensitive: false
